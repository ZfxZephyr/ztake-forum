{
  "name": "ztake-forum",
  "private": true,
  "version": "0.2.0",
  "description": "ztake — 现代简约论坛（Vue 3 前端 + Express 后端 monorepo）",
  "workspaces": [
    "ztake-ui",
    "ztake-service"
  ],
  "scripts": {
    "dev": "npm run dev --workspace ztake-ui & npm run dev --workspace ztake-service",
    "dev:fe": "npm run dev --workspace ztake-ui",
